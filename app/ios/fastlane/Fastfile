require "shellwords"

default_platform(:ios)

platform :ios do
  desc "Compile Gemelo et l'envoyer sur TestFlight"
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
      is_key_content_base64: false
    )

    increment_build_number(
      xcodeproj: "App/App.xcodeproj",
      build_number: ENV.fetch("BUILD_NUMBER")
    )

    keychain_path = File.expand_path("~/Library/Keychains/fastlane_tmp_keychain-db")
    keychain_password = ENV["KEYCHAIN_PASSWORD"].to_s

    # Le runner CI n'a jamais la clé privée des certificats précédents :
    # on libère le quota Apple puis on en crée un neuf pour ce build.
    Spaceship::ConnectAPI::Certificate.all.select { |certificate|
      %w[DISTRIBUTION IOS_DISTRIBUTION].include?(certificate.certificate_type)
    }.each do |certificate|
      UI.important("Révocation du certificat #{certificate.id} (#{certificate.certificate_type})")
      certificate.delete!
    end

    cert(
      api_key: api_key,
      generate_apple_certs: false,
      keychain_path: keychain_path,
      keychain_password: keychain_password
    )

    sh("security unlock-keychain -p #{keychain_password.shellescape} #{keychain_path.shellescape}")
    sh("security set-keychain-settings -t 3600 -l #{keychain_path.shellescape}")
    sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k #{keychain_password.shellescape} #{keychain_path.shellescape} || true")

    # Push (aps-environment) doit être actif sur l'App ID avant le profil.
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key: ENV.fetch("APP_STORE_CONNECT_API_KEY")
    )
    bundle = Spaceship::ConnectAPI.get_bundle_ids(filter: { identifier: "online.gemelo.app" }).first
    UI.user_error!("Bundle ID online.gemelo.app introuvable") unless bundle
    caps = Spaceship::ConnectAPI.get_bundle_id_capabilities(bundle_id_id: bundle.id)
    has_push = caps.any? { |cap|
      type = cap.capability_type.to_s
      type == "PUSH_NOTIFICATIONS" || type.end_with?("PUSH_NOTIFICATIONS")
    }
    unless has_push
      UI.important("Activation Push Notifications sur online.gemelo.app")
      Spaceship::ConnectAPI.post_bundle_id_capability(
        bundle_id_id: bundle.id,
        capability_type: Spaceship::ConnectAPI::BundleIdCapability::Type::PUSH_NOTIFICATIONS,
        settings: []
      )
    end

    sigh(
      api_key: api_key,
      app_identifier: "online.gemelo.app",
      force: true
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App/App.xcodeproj",
      team_id: "2K393S427L",
      targets: ["App"],
      build_configurations: ["Release"],
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME],
      bundle_identifier: "online.gemelo.app"
    )

    build_app(
      project: "App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      destination: "generic/platform=iOS",
      export_method: "app-store",
      output_directory: "build",
      output_name: "Gemelo.ipa",
      xcargs: "DEVELOPMENT_TEAM=2K393S427L",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: "2K393S427L",
        provisioningProfiles: {
          "online.gemelo.app" => lane_context[SharedValues::SIGH_NAME]
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "build/Gemelo.ipa",
      skip_waiting_for_build_processing: true,
      uses_non_exempt_encryption: false
    )
  end

  desc "Soumettre la version iOS en review App Store (binaire déjà sur TestFlight)"
  lane :submit do
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
      is_key_content_base64: false
    )

    version = ENV.fetch("APP_VERSION", "1.0")
    build_number = ENV["BUILD_NUMBER"].to_s.strip
    if build_number.empty?
      build_number = latest_testflight_build_number(
        api_key: api_key,
        app_identifier: "online.gemelo.app",
        version: version
      ).to_s
    end
    UI.important("Soumission Gemelo #{version} (build #{build_number})")

    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key: ENV.fetch("APP_STORE_CONNECT_API_KEY")
    )
    app = Spaceship::ConnectAPI::App.find("online.gemelo.app")
    UI.user_error!("App online.gemelo.app introuvable") unless app

    # Attendre que Apple ait fini le traitement du binaire (VALID).
    deadline = Time.now + 45 * 60
    ready_build = nil
    loop do
      builds = Spaceship::ConnectAPI.get_builds(
        filter: {
          app: app.id,
          version: build_number,
          "preReleaseVersion.version" => version
        },
        includes: "preReleaseVersion",
        sort: "-uploadedDate",
        limit: 10
      )
      match = builds.find { |item| item.version.to_s == build_number.to_s }
      state = match&.processing_state.to_s
      UI.message("Build #{build_number} — processingState=#{state.empty? ? 'inconnu' : state}")
      if match && %w[VALID PROCESSED].include?(state)
        ready_build = match
        break
      end
      if match && %w[INVALID FAILED PROCESSING_EXCEPTION].include?(state)
        UI.user_error!("Build #{build_number} en echec Apple (#{state})")
      end
      UI.user_error!("Timeout: build #{build_number} pas encore pret apres 45 min") if Time.now > deadline
      sleep 30
    end
    UI.success("Build #{build_number} pret (#{ready_build.id})")

    deliver(
      api_key: api_key,
      app_identifier: "online.gemelo.app",
      app_version: version,
      build_number: build_number,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      skip_app_version_update: true,
      submit_for_review: true,
      automatic_release: false,
      phased_release: false,
      force: true,
      reject_if_possible: false,
      run_precheck_before_submit: true,
      # Precheck IAP exige un login Apple ID ; la cle API ne le permet pas encore.
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        add_id_info_serves_ads: false,
        add_id_info_tracks_action: false,
        add_id_info_tracks_install: false,
        add_id_info_limits_tracking: false,
        content_rights_has_rights: true,
        content_rights_contains_third_party_content: false,
        export_compliance_uses_encryption: false,
        export_compliance_encryption_updated: false
      }
    )
  end
end
